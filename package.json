{
  "name": "rigora",
  "private": true,
  "packageManager": "pnpm@10.16.1",
  "scripts": {
    "dev": "pnpm --filter @rigora/editor-shell dev",
    "dev:lab": "pnpm --filter @rigora/compatibility-lab dev",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "test:browser": "playwright test",
    "benchmark:selection": "node tools/benchmark-selection.mjs",
    "release:metadata": "node tools/generate-release-metadata.mjs",
    "release:preflight": "node tools/release-preflight.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r build && pnpm -r typecheck",
    "test": "vitest run",
    "lint": "prettier --check . && node tools/check-boundaries.mjs",
    "format": "prettier --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bezier-js": "^4.1.3",
    "@types/delaunator": "^5.0.3",
    "@types/earcut": "^3.0.0",
    "@types/rbush": "^4.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "pixi.js": "8.21.0",
    "bezier-js": "^6.1.4",
    "comlink": "^4.4.2",
    "delaunator": "^5.1.0",
    "dexie": "^4.4.6",
    "earcut": "^3.2.3",
    "fflate": "^0.8.3",
    "flexlayout-react": "^0.11.0",
    "gl-matrix": "^3.4.4",
    "maxrects-packer": "^2.7.3",
    "pixi-viewport": "^6.0.3",
    "polygon-clipping": "^0.15.7",
    "rbush": "^4.0.1",
    "react": "^19.3.0",
    "react-arborist": "^3.16.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-router": "^8.4.0",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  }
}
