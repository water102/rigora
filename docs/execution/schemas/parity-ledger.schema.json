{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rigora.local/schemas/parity-ledger.schema.json",
  "title": "Rigora Parity Ledger",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "title",
      "step",
      "owner",
      "priority",
      "dependencies",
      "layers",
      "strategy",
      "provenance",
      "oracles",
      "tests",
      "status"
    ],
    "properties": {
      "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2}$" },
      "title": { "type": "string" },
      "step": { "type": "integer", "minimum": 0, "maximum": 15 },
      "owner": { "type": "string" },
      "priority": { "enum": ["p0", "p1", "p2"] },
      "dependencies": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string" }
      },
      "layers": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "runtime",
          "editor",
          "command",
          "import",
          "export",
          "tests",
          "performance"
        ],
        "properties": {
          "model": { "$ref": "#/$defs/layer" },
          "runtime": { "$ref": "#/$defs/layer" },
          "editor": { "$ref": "#/$defs/layer" },
          "command": { "$ref": "#/$defs/layer" },
          "import": { "$ref": "#/$defs/layer" },
          "export": { "$ref": "#/$defs/layer" },
          "tests": { "$ref": "#/$defs/layer" },
          "performance": { "$ref": "#/$defs/layer" }
        }
      },
      "strategy": { "enum": ["replicate", "adapt", "equivalent"] },
      "provenance": { "type": "array", "items": { "type": "string" } },
      "licenseOrPermission": { "type": ["string", "null"] },
      "oracles": { "type": "array", "items": { "type": "string" } },
      "tolerance": { "type": ["string", "null"] },
      "fixtures": { "type": "array", "items": { "type": "string" } },
      "tests": { "type": "array", "items": { "type": "string" } },
      "uxDeviation": { "type": ["string", "null"] },
      "status": {
        "enum": [
          "missing",
          "in_progress",
          "blocked",
          "complete",
          "verified",
          "exception"
        ]
      },
      "reviewer": { "type": ["string", "null"] },
      "verifiedCommit": { "type": ["string", "null"] },
      "exception": { "type": ["object", "null"] }
    }
  },
  "$defs": {
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {
          "enum": [
            "missing",
            "foundation",
            "lab",
            "partial",
            "implemented",
            "verified",
            "not_applicable"
          ]
        },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
