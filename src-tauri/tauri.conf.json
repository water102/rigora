{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rigora",
  "version": "0.1.0",
  "identifier": "com.rigora.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @rigora/compatibility-lab dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --filter @rigora/compatibility-lab build",
    "frontendDist": "../apps/compatibility-lab/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Rigora · Compatibility Lab",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
